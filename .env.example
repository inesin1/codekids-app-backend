DATABASE_URL=

# openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

BONUS_AMOUNT="50"
BONUS_WINDOW_HOURS="24"

# оставь пустым локально — тогда Sentry молчит и не шлёт dev-ошибки в прод-проект
SENTRY_DSN=

# Telegram: пустой токен — интеграция выключена.
# Локально — токен отдельного dev-бота (polling снимает webhook у бота)
TELEGRAM_BOT_TOKEN=
# Только прод: https://<домен>/api/telegram/webhook; без него — long polling
TELEGRAM_WEBHOOK_URL=
# openssl rand -hex 32 (обязателен вместе с TELEGRAM_WEBHOOK_URL)
TELEGRAM_WEBHOOK_SECRET=

# Адрес фронта для ссылок «Открыть в личном кабинете» в сообщениях
APP_URL=

