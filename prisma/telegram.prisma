// ============================================================================
// TELEGRAM ИНТЕГРАЦИЯ
// ============================================================================

// Группу создаёт человек (Bot API не умеет создавать чаты), бот привязывает её
// к ученику по одноразовой ссылке t.me/<bot>?startgroup=<token>
model TelegramGroup {
  id String @id @default(cuid())

  studentId String         @unique // userId ученика
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  telegramChatId String @unique // ID чата/группы в Telegram

  isActive Boolean @default(true) // false — бота удалили из группы

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_groups")
}

enum NotificationType {
  LESSON_REPORT
  LESSON_RESCHEDULE
  LESSON_CANCEL
  RESCHEDULE_REQUEST
  MATERIAL_ADDED
  PAYOUT_NOTIFICATION
  STAFF_DIGEST
}

// Outbox: строка — желаемое состояние сообщения в Telegram.
// sentAt = null → воркер отправит (или отредактирует, если telegramMessageId уже есть)
model TelegramNotification {
  id String @id @default(cuid())

  chatId String // группа ученика или личка пользователя
  type   NotificationType

  entityId String? // reportId / requestId / lessonId / payoutId

  text        String @db.Text // HTML
  replyMarkup Json? // inline-кнопки

  telegramMessageId Int?
  sentAt            DateTime?
  attempts          Int       @default(0)
  error             String? // последняя ошибка отправки

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sentAt])
  @@index([type, entityId])
  @@map("telegram_notifications")
}

enum TelegramLinkKind {
  GROUP // привязка группы ученика (userId = ученик)
  PRIVATE // привязка личного чата пользователя
}

// Одноразовый токен для deep link, удаляется при использовании
model TelegramLinkToken {
  token String @id

  kind TelegramLinkKind

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  @@index([userId])
  @@map("telegram_link_tokens")
}
