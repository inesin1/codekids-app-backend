// ============================================================================
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  TEACHER
  PARENT
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique // null = lite-пользователь без доступа в ЛК
  contacts  Json? // [{ id, label, value }] — кастомные контакты (телефон, мессенджеры и т.д.)
  password  String? // null = вход в ЛК недоступен
  firstName String
  lastName  String
  // только ADMIN/MANAGER. Участие TEACHER/PARENT/STUDENT определяется наличием профиля
  staffRoles Role[]  @default([])
  isActive   Boolean @default(true)
  avatarUrl  String?

  telegramChatId String? @unique // для прямых уведомлений пользователю

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ролевые профили — источник правды об участии в домене
  teacherProfile TeacherProfile?
  parentProfile  ParentProfile?
  studentProfile StudentProfile?

  // Общие связи
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  rescheduleRequestsCreated RescheduleRequest[] @relation("RescheduleCreatedBy")
  rescheduleRequestsResolved RescheduleRequest[] @relation("RescheduleResolvedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Профиль преподавателя
// ---------------------------------------------------------------------------
model TeacherProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Связки «преподаватель — ученик» с индивидуальными ставками
  enrollments      Enrollment[]
  scheduleTemplates ScheduleTemplate[]
  lessons          Lesson[]
  payouts          Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

// ---------------------------------------------------------------------------
// Профиль родителя
// ---------------------------------------------------------------------------
model ParentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Баланс (в рублях, может быть отрицательным = задолженность)
  balance Decimal @default(0) @db.Decimal(12, 2)

  // 1 родитель → N учеников
  students     StudentProfile[]
  payments     Payment[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parent_profiles")
}

// ---------------------------------------------------------------------------
// Профиль ученика
// ---------------------------------------------------------------------------
model StudentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String? // userId родителя; null для пробных учеников без оформленного родителя
  parent   ParentProfile? @relation(fields: [parentId], references: [userId])

  birthDate DateTime? @db.Date

  enrollments       Enrollment[]
  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  telegramGroup     TelegramGroup?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("student_profiles")
}

// ============================================================================
// СВЯЗКА ПРЕПОДАВАТЕЛЬ ↔ УЧЕНИК
// Хранит индивидуальные ставки
// ============================================================================
// ---------------------------------------------------------------------------
// Refresh-токены (JWT rotation)
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Enrollment {
  id String @id @default(cuid())

  teacherId String // userId преподавателя
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId])

  studentId String // userId ученика
  student   StudentProfile @relation(fields: [studentId], references: [userId])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Индивидуальная стоимость занятия для родителя (списание)
  lessonPrice Decimal @db.Decimal(10, 2)

  // Индивидуальная ставка преподавателя за занятие (начисление)
  teacherRate Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]

  @@unique([teacherId, studentId, courseId])
  @@index([teacherId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}