// ============================================================================
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ============================================================================

enum Role {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
}

model User {
  id        String   @id @default(cuid())
  login      String?   @unique // null = пользователь без доступа в ЛК
  email      String? // контактный email, может повторяться
  contacts  Json? // [{ id, label, value }] — кастомные контакты (телефон, мессенджеры и т.д.)
  password  String? // null = вход в ЛК недоступен
  securityVersion Int @default(0)
  firstName String
  lastName  String
  // Только ADMIN/MANAGER. Участие TEACHER/STUDENT определяется наличием профиля
  staffRoles Role[]  @default([])
  isActive   Boolean @default(true)
  avatarUrl  String?
  birthDate  DateTime? @db.Date

  // Личный чат с ботом (= Telegram user id). Ставит только бот: по нему опознаётся
  // нажавший inline-кнопку, ручной ввод позволил бы действовать от чужого имени
  telegramChatId String?
  telegramBindingVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ролевые профили — источник правды об участии в домене
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  // Общие связи
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  telegramLinkTokens TelegramLinkToken[]
  rescheduleRequestsCreated RescheduleRequest[] @relation("RescheduleCreatedBy")
  rescheduleRequestsResolved RescheduleRequest[] @relation("RescheduleResolvedBy")

  @@index([telegramChatId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Профиль преподавателя
// ---------------------------------------------------------------------------
model TeacherProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Связки «преподаватель — ученик» с индивидуальными ставками
  enrollments      Enrollment[]
  scheduleTemplates ScheduleTemplate[]
  lessons          Lesson[]
  payouts          Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teacher_profiles")
}

// ---------------------------------------------------------------------------
// Профиль ученика
// ---------------------------------------------------------------------------
model StudentProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentName     String?
  parentContacts Json? // [{ id, label, value }]
  balance        Decimal @default(0) @db.Decimal(12, 2)

  enrollments       Enrollment[]
  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  payments          Payment[]
  transactions      Transaction[]
  telegramGroup     TelegramGroup?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

// ============================================================================
// СВЯЗКА ПРЕПОДАВАТЕЛЬ ↔ УЧЕНИК
// Хранит индивидуальные ставки
// ============================================================================
// ---------------------------------------------------------------------------
// Refresh-токены (JWT rotation)
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Enrollment {
  id String @id @default(cuid())

  teacherId String // userId преподавателя
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId])

  studentId String // userId ученика
  student   StudentProfile @relation(fields: [studentId], references: [userId])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Индивидуальная стоимость занятия для родителя (списание)
  lessonPrice Decimal @db.Decimal(10, 2)

  // Индивидуальная ставка преподавателя за занятие (начисление)
  teacherRate Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]

  @@unique([teacherId, studentId, courseId])
  @@unique([id, teacherId, studentId], map: "enrollments_id_teacherId_studentId_key")
  @@index([teacherId])
  @@index([studentId])
  @@index([courseId])
  @@map("enrollments")
}
